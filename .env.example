# Stickies - environment variables
# Copy to .env.local and fill in. Placeholders below are NOT real secrets.
# Grouped: REQUIRED (app will not run without these) -> optional integrations -> script-only.
# NODE_ENV / VERCEL / VERCEL_ENV are set by the runtime - do not add them here.

# ----------------------------------------------------------------------------
# REQUIRED - core app
# ----------------------------------------------------------------------------
# Postgres connection string (self-hosted Linode). Empty = pool crashes on first query.
DATABASE_URL=postgres://user:password@host:5432/dbname
# NextAuth v5 session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=generate-a-32-byte-random-secret
# The owner's Google account email - the only identity that passes owner auth.
OWNER_EMAIL=you@example.com
# The owner's user id that every note is owned by. If unset, ext-API notes resolve
# to userId '' and existing notes stop resolving - REQUIRED for correct ownership.
OWNER_USER_ID=your-owner-user-id
# Google OAuth (Sign in with Google, PKCE flow)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ----------------------------------------------------------------------------
# REQUIRED - realtime (Pusher). Server + public (NEXT_PUBLIC_*) halves.
# ----------------------------------------------------------------------------
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ----------------------------------------------------------------------------
# RECOMMENDED - DB TLS. Without this, remote Postgres TLS falls back to
# rejectUnauthorized:false (unverified/MITM-able). PEM or base64 of the server CA.
# ----------------------------------------------------------------------------
DATABASE_CA_CERT=

# ----------------------------------------------------------------------------
# External API + CLI keys (agents, scripts, automations)
# ----------------------------------------------------------------------------
STICKIES_API_KEY=your-static-api-key
STICKIES_PASSWORD=a-strong-generated-password
# On Vercel prod, only the key with this label is accepted (prod lockdown).
STICKIES_PROD_KEY=the-allowlisted-prod-key
STICKIES_PROD_KEY_LABEL=claude-routine

# ----------------------------------------------------------------------------
# Optional integrations
# ----------------------------------------------------------------------------
# AI prompt bar (streams Claude into a note). Optional feature.
ANTHROPIC_API_KEY=
# GitHub token for the /backup export target
GITHUB_BACKUP_TOKEN=
# Public app base URL (used in share links / OG). Defaults to the request origin if unset.
NEXT_PUBLIC_APP_BASE_URL=https://stickies.example.com
# Philips Hue new-note light flash - internal base URL the API self-calls (default http://127.0.0.1:4444).
HUE_INTERNAL_BASE_URL=http://127.0.0.1:4444

# ----------------------------------------------------------------------------
# Optional - machine registry (device badges on notes)
#
# Names the machines that post to this board so a note can show the device it came
# from. All optional: leave unset and every note simply carries no device badge.
# NEXT_PUBLIC_ because tiles resolve icons in the browser too, so rebuild after a
# change. Addresses below are RFC 5737 documentation addresses - use your own LAN
# addresses, which stay out of the repo because they live only in .env.local.
# ----------------------------------------------------------------------------
# The machine this server runs on. Localhost posts are attributed to it, and it is
# the one machine that gets NO badge (it is the default origin). Default: "hub".
NEXT_PUBLIC_STICKIES_HUB_MACHINE=hub
# ip=name pairs for peers that post over the LAN.
NEXT_PUBLIC_STICKIES_MACHINE_IPS=192.0.2.10=hub,192.0.2.11=laptop
# name=model pairs. Models: "mac mini", "macbook pro", "macbook air".
NEXT_PUBLIC_STICKIES_MACHINE_MODELS=hub=mac mini,laptop=macbook pro
# Machines whose device icon always wins over the posting app's icon.
NEXT_PUBLIC_STICKIES_FORCE_MACHINES=laptop
# Server-only: peers to resolve by <name>.local when their DHCP address is unknown.
STICKIES_PEER_HOSTS=laptop

# ----------------------------------------------------------------------------
# Script-only (CLI) - not read by the Next.js app itself
# ----------------------------------------------------------------------------
STICKIES_URL=http://localhost:4444
