{
  "name": "stickies",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time, AI-powered sticky notes board that syncs across every device.",
  "license": "MIT",
  "author": "Bunlong Heng",
  "homepage": "https://github.com/bunlongheng/stickies#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunlongheng/stickies.git"
  },
  "bugs": {
    "url": "https://github.com/bunlongheng/stickies/issues"
  },
  "keywords": [
    "notes",
    "sticky-notes",
    "nextjs",
    "react",
    "postgresql",
    "pusher",
    "real-time",
    "self-hosted"
  ],
  "scripts": {
    "stickies": "node scripts/stickies-cli.mjs",
    "stickies:key": "node scripts/stickies-key.mjs",
    "predev": "node scripts/dev-banner.mjs; kill $(/usr/sbin/lsof -ti :4444) 2>/dev/null || true",
    "dev": "node scripts/dev.mjs",
    "hub": "node scripts/hub-serve.mjs",
    "build": "next build",
    "start": "next start",
    "prod": "next build && next start -p 4444 --hostname 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run --coverage && playwright test",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "lint": "eslint . --max-warnings 485",
    "typecheck": "tsc --noEmit",
    "migrate": "node db/migrate.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/pg-adapter": "^1.11.3",
    "@heroicons/react": "^2.2.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/pg": "^8.18.0",
    "@types/prismjs": "^1.26.6",
    "googleapis": "^171.4.0",
    "html-to-image": "^1.11.13",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "prismjs": "^1.30.0",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
