# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
test-results/
.env*.local

# leaked-token DB dumps - never commit
backups/
local.db
*.db

# local scratch files with prod DB creds - never commit
export-stickies.mjs
audit-report.html

# Local npm config (registry, and any auth token added later)
.npmrc

# One-off local import artifact: holds private note titles and ids
scripts/.import-manifest.json

# Build output
dist/
